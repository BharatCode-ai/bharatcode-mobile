{
  "name": "bharatcode-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "web": "EXPO_PUBLIC_BC_PREVIEW=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:security",
    "test:security": "node --test security/*.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "58.0.22",
    "expo-asset": "~58.0.19",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "node-forge": "file:vendor/node-forge"
  },
  "overrides": {
    "markdown-it": "14.3.3",
    "linkify-it": "5.0.2",
    "zod": "4.6.7",
    "node-forge": "$node-forge"
  }
}
